{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|products/|appearance.js|favicon.svg|product-import-template.csv|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://insights.bittrees.org; style-src 'self' 'unsafe-inline' https://insights.bittrees.org; img-src 'self' data: https:; connect-src 'self' https://insights.bittrees.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "35 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "marcada.bittrees.org"
        }
      ],
      "destination": "https://mercado.bittrees.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "marcado.bittrees.org"
        }
      ],
      "destination": "https://mercado.bittrees.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "marcada.vercel.app"
        }
      ],
      "destination": "https://mercado.bittrees.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "marcado.vercel.app"
        }
      ],
      "destination": "https://mercado.bittrees.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mercado.vercel.app"
        }
      ],
      "destination": "https://mercado.bittrees.org/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  }
}
